#!/usr/bin/env bash
# The single worker executable ci/run-integration.sh drives: no arguments =
# stdio, `--http --port 0` = HTTP (prints PORT:<n>), and the SDK's own launch
# (unix socket) mode. Runs the project venv's vgi-hackernews entry point.
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
exec "$REPO/.venv/bin/vgi-hackernews" "$@"
